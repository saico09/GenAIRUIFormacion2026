{
  "uid": "genai-apis",
  "title": "APIs GenAI",
  "description": "Tráfico, errores y latencia p95 por API, sin el scrape de Prometheus ni /health. Ventana de 5 minutos; la latencia de /chat usa 30 minutos.",
  "tags": [
    "genai"
  ],
  "schemaVersion": 41,
  "version": 3,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "FastAPI",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Tráfico",
      "description": "Peticiones/s de la aplicación; sin el scrape de Prometheus (/metrics) ni /health.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"fastapi\",route!~\"/metrics|/health\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "displayName": "Tráfico"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Errores 5xx",
      "description": "Porcentaje de respuestas 5xx sobre el total de la aplicación.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{service=\"fastapi\",route!~\"/metrics|/health\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{service=\"fastapi\",route!~\"/metrics|/health\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "displayName": "Errores 5xx"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Respuestas 4xx",
      "description": "Porcentaje de 4xx (404, 422...): errores del cliente, aparte de los 5xx.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{service=\"fastapi\",route!~\"/metrics|/health\",status=~\"4..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{service=\"fastapi\",route!~\"/metrics|/health\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "displayName": "Respuestas 4xx"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Latencia p95 (sin /chat)",
      "description": "p95 del CRUD y demás rutas; /chat tiene su propio panel.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"fastapi\",route!~\"/metrics|/health|/chat\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "displayName": "Latencia p95 (sin /chat)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "Latencia p95 de /chat",
      "description": "p95 de /chat (dos llamadas al LLM). Ventana de 30 minutos porque hay pocas consultas; buckets hasta 300 s.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
